# Line endings. Scoped to the code this repo actually writes: venv/ is tracked
# (7,505 vendored files, ignored too late), and a repo-wide rule would rewrite
# every one of them on the next commit that touches it.
#
# LF in the tree and in the checkout. The Flutter tool writes LF, so without
# this Windows keeps re-marking its generated registrants as modified when
# nothing in them changed.
apps/** text=auto eol=lf
config/** text=auto eol=lf
tests/** text=auto eol=lf
scripts/** text=auto eol=lf
web/** text=auto eol=lf
mobile/** text=auto eol=lf
docs/** text=auto eol=lf
*.md text=auto eol=lf
*.py text=auto eol=lf

# Byte-for-byte, never touched.
*.png binary
*.jpg binary
*.ico binary
*.svg text eol=lf
*.ttf binary
*.woff binary
*.woff2 binary
*.jar binary
*.keystore binary
*.pdf binary
*.mo binary

# Windows shells still want CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
