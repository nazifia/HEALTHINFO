{
  "hosting": {
    "public": "build/web",
    "predeploy": [
      "node ../scripts/deploy_guard.js healthinfoapp2 healthinfoapp --require build/web/main.dart.js"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.symbols",
      "**/*.map"
    ],
    "headers": [
      {
        "source": "**/@(index.html|flutter_bootstrap.js|flutter_service_worker.js|version.json|manifest.json)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "**/@(main.dart.js|flutter.js)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/assets/**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/canvaskit/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/@(*.png|*.svg|*.ico|*.woff2|*.otf|*.ttf)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=604800" }
        ]
      }
    ]
  }
}
